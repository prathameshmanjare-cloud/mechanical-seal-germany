      "permanent": true
    },
    {
      "source": "/sic-wc-kohle-keramik-anfertigung-nach-zeichnung.html",
      "destination": "/shop/mechanical-seal-components/seal-face-sets/",
      "permanent": true
    },
    {
      "source": "/radialwellendichtringe.html",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/drehdurchfuehrungen.html",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/wehrtechnik.html",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/impressum.html",
      "destination": "/legal-notice/",
      "permanent": true
    },
    {
      "source": "/products/:slug",
      "destination": "/shop/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|data/).*)",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "content/sap-parts/01_Artikel_und_Filter/{categories.csv,filter_definitions.csv,product_category_links.csv,products_import.csv.gz}",
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
